# Copy this file to .env and fill in the values
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

FRONTEND_ORIGIN=http://localhost:5173
PORT=5001

# --- Optional: SMTP email (for password reset emails) ---
# If not set, reset tokens are logged to the server console (development mode).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false           # true for port 465
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password  # Gmail: use an App Password, not your account password
# SMTP_FROM="Azure Coast Guide" <noreply@yourdomain.com>
